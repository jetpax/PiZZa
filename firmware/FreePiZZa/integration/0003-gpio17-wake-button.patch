Retarget wake button to GPIO17, pull-up, falling-edge

vc4-suspend's original configure_gpio3_wake() has an internal
contradiction: it sets pull-DOWN + rising-edge (correct only if the
button is wired to 3.3 V), while its README diagram shows the button
wired to GND (which needs pull-UP + falling-edge). Since nothing has
run on silicon yet the mismatch never bit anyone.

Fix and retarget in one pass -- Free PiZZa's bench hardware already
has a button wired between GPIO17 (pin 11) and GND (pin 9):

- GPFSEL0 [11:9] (GPIO3)   ->  GPFSEL1 [23:21] (GPIO17)
- GPPUD = 0x01 (pull-down) ->  GPPUD = 0x02 (pull-up)
- GPPUDCLK0 bit 3          ->  GPPUDCLK0 bit 17
- GPREN0  bit 3 (rising)   ->  GPFEN0  bit 17 (falling)
- GPEDS0  bit 3 (config)   ->  GPEDS0  bit 17
- GPEDS0  bit 3 (ack)      ->  GPEDS0  bit 17
- wait loop GPEDS0 & (1<<3)->  GPEDS0 & (1<<17)

Plus update the 5 user-facing DBG strings that still said "GPIO3":
- "[suspend] To wake: ..." in boot_suspend_hook.c
- "[suspend] Configuring GPIO3 wake..." in suspend_enter
- "[suspend] Sleeping -- waiting for GPIO3..." in wait_for_gpio3_wake
- "[suspend] GPIO3 configured as wake source ..."
- "[suspend] GPIO3 wake event detected"

VPU IC0 GPIO-bank-0 routing (intno 49, covers pins 0-27) unchanged
-- any bank-0 pin fires the same wake.

Function/variable names retained (configure_gpio3_wake / wait_for_
gpio3_wake) to keep the diff small; a rename can follow later.

Apply with `git apply --ignore-whitespace` (src files may have mixed
line endings vs the LF-only patch).

diff --git a/src/boot_suspend_hook.c b/src/boot_suspend_hook.c
index 3870174..7853d28 100644
--- a/src/boot_suspend_hook.c
+++ b/src/boot_suspend_hook.c
@@ -126,7 +126,7 @@ void enter_suspend_mode(void) {
     int ret;

     uart_print("\n[suspend] System ready. Entering suspend-to-RAM...\n");
-    uart_print("[suspend] To wake: connect GPIO3 (pin 5) to 3V3 briefly\n");
+    uart_print("[suspend] To wake: press GPIO17 button (pin 11 to GND)\n");

     ret = suspend_enter();

diff --git a/src/suspend.c b/src/suspend.c
index 1d95642..5142839 100644
--- a/src/suspend.c
+++ b/src/suspend.c
@@ -374,7 +374,7 @@ int suspend_enter(void) {

     /* ---- Phase 2: Configure wake source ---- */

-    DBG("[suspend] Configuring GPIO3 wake...\n");
+    DBG("[suspend] Configuring GPIO17 wake...\n");
     configure_gpio3_wake();

     /* ---- Phase 3: Power down ---- */
@@ -412,7 +412,7 @@ int suspend_enter(void) {
      * Power draw during this phase: target ~2-5 mA.
      */

-    DBG("[suspend] Sleeping -- waiting for GPIO3...\n");
+    DBG("[suspend] Sleeping -- waiting for GPIO17...\n");
     wait_for_gpio3_wake();

     /* ---- Phase 5: Wake and restore ---- */
@@ -1066,28 +1066,29 @@ static void power_ungate_arm(void) {
  * Wake trigger: momentarily connect GPIO3 to 3V3, or use RTC alarm.
  * -------------------------------------------------------------------------- */
 static void configure_gpio3_wake(void) {
-    /* GPIO3 function select: input (bits [11:9] = 000) */
-    GPFSEL0 &= ~(0x7 << 9);
+    /* GPIO17 function select: input (GPFSEL1 bits [23:21] = 000) */
+    GPFSEL1 &= ~(0x7 << 21);

-    /* Enable pull-down on GPIO3.
+    /* Enable pull-UP on GPIO17 (button wired to GND -> pull-up idles HIGH,
+     * button press pulls LOW, release returns HIGH).
      * BCM2835 pull-up/down sequence (ARM Peripherals §6.1):
      *   1. Write to GPPUD to set pull direction
      *   2. Wait 150 cycles
-     *   3. Write to GPPUDCLK0 to clock it into GPIO3
+     *   3. Write to GPPUDCLK0 to clock it into GPIO17
      *   4. Wait 150 cycles
      *   5. Clear GPPUD and GPPUDCLK0 */
-    GPPUD = 0x01;           /* 01 = Assert pull-down */
+    GPPUD = 0x02;           /* 10 = Assert pull-up */
     udelay(5);              /* >150 cycles at any reasonable VPU clock */
-    GPPUDCLK0 = (1 << 3);  /* Clock pull config into GPIO3 */
+    GPPUDCLK0 = (1 << 17); /* Clock pull config into GPIO17 */
     udelay(5);
     GPPUD = 0x00;
     GPPUDCLK0 = 0x00;

-    /* Enable rising-edge detect on GPIO3 */
-    GPREN0 |= (1 << 3);
+    /* Enable falling-edge detect on GPIO17 (press pulls HIGH->LOW) */
+    GPFEN0 |= (1 << 17);

-    /* Clear any pending edge detect event */
-    GPEDS0 = (1 << 3);     /* Write-1-to-clear */
+    /* Clear any pending edge detect event on GPIO17 */
+    GPEDS0 = (1 << 17);    /* Write-1-to-clear */

     /* Route GPIO bank 0 interrupt to VPU core 0 so the `sleep`
      * instruction wakes on GPIO3 edge events.
@@ -1105,7 +1106,7 @@ static void configure_gpio3_wake(void) {
         *ic_reg = val | slot;   /* Enable GPIO0 bank interrupt on VPU core 0 */
     }

-    DBG("[suspend] GPIO3 configured as wake source (pull-down + rising edge)\n");
+    DBG("[suspend] GPIO17 configured as wake source (pull-up + falling edge)\n");
     DBG("[suspend] VPU IC0 GPIO bank 0 interrupt enabled\n");
 }

@@ -1123,7 +1124,7 @@ static void configure_gpio3_wake(void) {
  * GPIO0 bank IRQ fires → VPU wakes from sleep.
  * -------------------------------------------------------------------------- */
 static void wait_for_gpio3_wake(void) {
-    while (!(GPEDS0 & (1 << 3))) {
+    while (!(GPEDS0 & (1 << 17))) {
         /* VC4 sleep instruction -- halts VPU until interrupt */
         __asm__ __volatile__("sleep" :::);

@@ -1133,9 +1134,9 @@ static void wait_for_gpio3_wake(void) {
     }

     /* Clear the event */
-    GPEDS0 = (1 << 3);
+    GPEDS0 = (1 << 17);

-    DBG("[suspend] GPIO3 wake event detected\n");
+    DBG("[suspend] GPIO17 wake event detected\n");
 }

