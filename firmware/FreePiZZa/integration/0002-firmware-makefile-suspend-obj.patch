Link Free PiZZa suspend objects into bootcode.bin

The vc4-suspend src/ directory builds four objects that the
upstream firmware Makefile does not know about:

  build/suspend.o             — SDRAM self-refresh, ARM power-gate, VPU sleep
  build/resume.o              — VPU wake handler + atomic register save
  build/boot_suspend_hook.o   — check_resume_from_suspend / enter_suspend_mode
  build/uart_wrappers.o       — uart_print / uart_print_hex over xprintf's puts/printf

Add them to the top-level OBJ so bootcode.elf pulls them in.
Without this, the objects compile as orphans and the calls we added
in 0001 link-fail (or worse, silently link against weak stubs).

Applied against pristine librerpi/rpi-open-firmware
submodule commit 2725d94.

--- a/firmware/Makefile
+++ b/firmware/Makefile
@@ -24,7 +24,15 @@ SRCS = \

 BASE_OBJ := $(addprefix build/, $(addsuffix .o, $(basename $(SRCS))))
 EXTRA_OBJ := arm_chainloader.o
-OBJ := $(BASE_OBJ) $(EXTRA_OBJ)
+
+# Free PiZZa suspend module objects (built by src/ under vc4-suspend)
+SUSPEND_OBJ := \
+	../../build/suspend.o \
+	../../build/resume.o \
+	../../build/boot_suspend_hook.o \
+	../../build/uart_wrappers.o
+
+OBJ := $(BASE_OBJ) $(EXTRA_OBJ) $(SUSPEND_OBJ)

 include $(BASE_OBJ:.o=.d)

