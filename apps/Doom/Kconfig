# PiZZa sdl2-doom port -- app options. Backend choices are the seams the
# app's CMakeLists uses to pick the present/audio TU.

# SAMPLE_USBD_* options for sample_usbd_init.c on boards with the USB
# device stack (rpi_zero_2w).
source "samples/subsys/usb/common/Kconfig.sample_usbd"

rsource "../lib/sdl2shim/Kconfig"

menu "PiZZa sdl2-doom port"

choice DOOM_PRESENT_BACKEND
	prompt "Frame present backend"
	default DOOM_PRESENT_DISPLAY if DISPLAY
	default DOOM_PRESENT_NONE

config DOOM_PRESENT_DISPLAY
	bool "Zephyr display API (bcm2835_fb + HVS scaling on hardware)"
	depends on DISPLAY

config DOOM_PRESENT_NONE
	bool "Drop frames (link/sim bring-up)"

config DOOM_PRESENT_SEMIHOST
	bool "Semihosting PPM capture (qemu sim gates)"
	depends on SEMIHOST

endchoice

config DOOM_CAPTURE_EVERY
	int "Capture every Nth presented frame (0 = first frame only)"
	depends on DOOM_PRESENT_SEMIHOST
	default 0

config DOOM_SCRIPTED_INPUT
	bool "Drive Doom from a scripted synthetic input source"
	default n

config DOOM_SIM_TUNING
	bool "Boot straight to E1M1 (-warp 1 1) for qemu sim gates"
	default n
	help
	  The title/demo loop renders far too slowly under qemu TCG to
	  reach interactively; -warp 1 1 drops straight into E1M1 so the
	  sim gates can capture gameplay. Requires an IWAD that contains
	  E1M1 (the shareware doom1.wad; the miniwad does not).

endmenu

source "Kconfig.zephyr"
