/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * PiZZa sdl2-doom overlay for rpi_zero_2w.
 *
 *   - &mbox0 + &firmware: VC mailbox + property tags (FB alloc).
 *   - &vc_fb: HDMI framebuffer at the monitor's EDID-negotiated scanout
 *     mode; the shim paints Doom's native 320x200 frame into the virtual
 *     FB and the VideoCore HVS scales it to the cable on the fly -- the
 *     same proven trick as the Jet / wipeout / SDLPoP ports. 320 * 4 =
 *     1280 bytes/row = 64-byte aligned, so the FB driver's
 *     contiguous-DMA fast path engages.
 *   - &dma: BCM2835 DMA (backbuffer->fb blit + the MAI audio feed).
 *   - &usb + cdc_acm child: USB CDC ACM `doom` shell endpoint.
 *   - mini-UART (uart1) console + LOG target, PiZZa convention.
 */

#include <zephyr/dt-bindings/display/panel.h>

&mbox0 {
	status = "okay";
};

&firmware {
	status = "okay";
};

&dma {
	status = "okay";
};

&vc_fb {
	pixel-format = <PANEL_PIXEL_FORMAT_ARGB_8888>;
	render-width = <320>;
	render-height = <200>;
	status = "okay";
};

&usb {
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "PiZZa Doom shell (USB CDC ACM)";
	};
};

/ {
	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,display = &vc_fb;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_gpio14>;
	status = "okay";
	current-speed = <115200>;
};
