# doom core build -- pulls the shim Kconfig for the SDL2SHIM_* symbols
# the shim TUs compile against (log level, libretro app stack). The
# audio-backend choice is irrelevant here (the core links the libretro
# audio pump directly).

rsource "../../lib/sdl2shim/Kconfig"

config DOOM_MUSIC_OPL
	bool "OPL2/OPL3 FM music (Chocolate Doom synth via GENMIDI)"
	default n
	help
	  Compile Chocolate Doom's OPL subsystem into the core (Nuked OPL3
	  emulator + i_oplmusic sequencer, referenced from CHOCOLATE_SRC_DIR)
	  and fold the synth into the shared mixer as a MIX_CHANNEL_POST
	  effect -- the same seam SFX already uses. Instruments come from the
	  WAD's GENMIDI lump; no external data. Mirrors the app build's
	  CONFIG_DOOM_MUSIC_OPL. The MUS->MIDI temp round-trip is RAM-backed
	  in doom_core_fs.c.

source "Kconfig.zephyr"
