/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * PiZZa Mini vMac overlay for rpi_zero_2w.
 *
 *   - &mbox0 + &firmware: VC mailbox + property tags (FB alloc).
 *   - &vc_fb: HDMI framebuffer at the monitor's EDID-negotiated scanout
 *     mode; the shim paints the Mac's native 512x342 frame into the virtual
 *     FB and the VideoCore HVS scales it to the cable on the fly -- the same
 *     proven trick as the Doom / wipeout / SDLPoP ports. 512 * 4 = 2048
 *     bytes/row = 64-byte aligned, so the FB driver's contiguous-DMA fast
 *     path engages.
 *   - &dma: BCM2835 DMA (backbuffer->fb blit).
 *   - &usb + cdc_acm child: USB CDC ACM `minivmac` shell endpoint.
 *   - mini-UART (uart1) console + LOG target, PiZZa convention.
 */

#include <zephyr/dt-bindings/display/panel.h>

&mbox0 {
	status = "okay";
};

&firmware {
	status = "okay";
};

&dma {
	status = "okay";
};

&vc_fb {
	pixel-format = <PANEL_PIXEL_FORMAT_ARGB_8888>;
	render-width = <512>;
	render-height = <342>;
	status = "okay";
};

&usb {
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "PiZZa Mini vMac shell (USB CDC ACM)";
	};
};

/ {
	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,display = &vc_fb;
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_gpio14>;
	status = "okay";
	current-speed = <115200>;
};
