# PiZZa libretro frontend -- app options.

# SAMPLE_USBD_* options for sample_usbd_init.c on boards with the USB
# device stack.
source "samples/subsys/usb/common/Kconfig.sample_usbd"

# Shared shim: audio-backend choice + SDL2SHIM log module.
rsource "../lib/sdl2shim/Kconfig"
# BT HID input (pad/keyboard/mouse) -- enabled per-board (rpi_zero_2w).
rsource "../lib/btinput/Kconfig"

menu "PiZZa libretro frontend"

choice RETRO_CORE_SOURCE
	prompt "libretro core source"
	default RETRO_CORE_STATIC

config RETRO_CORE_STATIC
	bool "Statically linked core (fused binary, RetroArch console model)"

config RETRO_CORE_LLEXT_EMBED
	bool "llext core embedded in the image (buf loader; sim)"
	depends on LLEXT

config RETRO_CORE_LLEXT_FS
	bool "llext core from the filesystem (fs loader; SD card)"
	depends on LLEXT && FILE_SYSTEM

endchoice

config RETRO_CORE_LLEXT_PATH
	string "Filesystem path of the core llext"
	depends on RETRO_CORE_LLEXT_FS
	default "/SD:/cores/2048.llext"

config RETRO_STORAGE_MOUNT
	string "Storage volume the frontend mounts (cores + saves)"
	depends on RETRO_CORE_LLEXT_FS
	default "/SD:"

config RETRO_MENU
	bool "Launcher menu (scan a cores dir, pick + swap in-process)"
	depends on RETRO_CORE_LLEXT_FS
	default y
	help
	  M4: on boot show a picker of the *.llext cores in
	  RETRO_MENU_DIR; launching one binds + runs it; the L+R pad
	  chord or `retro menu` tears it down and returns to the picker.
	  Without this the frontend runs the single RETRO_CORE_LLEXT_PATH
	  core forever (M3 behavior).

config RETRO_MENU_DIR
	string "Directory scanned for core llext files"
	depends on RETRO_MENU
	default "/SD:/cores"

config RETRO_CONTENT_DIR
	string "Directory scanned for content (ROMs/WADs)"
	depends on RETRO_MENU
	default "/SD:/roms"
	help
	  After picking a core that requires content, the launcher browses
	  this directory filtered by the core's valid_extensions. Created
	  at mount by retro_storage.c.

config RETRO_MENU_WIDTH
	int "Launcher render width (match the board's virtual FB)"
	depends on RETRO_MENU
	default 640

config RETRO_MENU_HEIGHT
	int "Launcher render height (match the board's virtual FB)"
	depends on RETRO_MENU
	default 480

config RETRO_QEMU_RAMDISK_SEED
	bool "Seed the qemu ram-disk with embedded cores (sim menu test)"
	depends on RETRO_CORE_LLEXT_FS && DISK_DRIVER_RAM
	default n
	help
	  qemu has no SD: this writes cores .incbin'd into the image onto
	  the formatted ram-disk at boot so the launcher's fs scan + swap
	  exercises the exact HW path.

config RETRO_AUDIO_GAIN_PERCENT
	int "Master audio volume (percent of unity)"
	depends on SDL2SHIM_AUDIO_HDMI
	range 0 200
	default 100
	help
	  RetroPiZZa-global master gain, applied to every core's mixed
	  stream as it enters the audio bridge (values above 100 amplify
	  with clamping). Runtime-adjustable with `retro vol <percent>`.

config RETRO_LLEXT_CYCLE_TEST
	int "Frames per bind cycle before unload/reload (0 = run forever)"
	default 0
	help
	  M2 gate: run N frames, tear the core down (unload_game, deinit,
	  llext unload), and let main() relaunch the frontend, which
	  reloads the core from scratch. The llext heap watermark is
	  logged pre-bind/post-unbind; allocated bytes must return to
	  baseline every cycle.

choice RETRO_PRESENT_BACKEND
	prompt "Frame present backend"
	default RETRO_PRESENT_DISPLAY if DISPLAY
	default RETRO_PRESENT_NONE

config RETRO_PRESENT_DISPLAY
	bool "Zephyr display API (bcm2835_fb + HVS scaling on hardware)"
	depends on DISPLAY

config RETRO_PRESENT_NONE
	bool "Drop frames (link/sim bring-up)"

config RETRO_PRESENT_SEMIHOST
	bool "Semihosting PPM capture (qemu sim gates)"
	depends on SEMIHOST

endchoice

config RETRO_CAPTURE_EVERY
	int "Capture every Nth presented frame (0 = first frame only)"
	depends on RETRO_PRESENT_SEMIHOST
	default 0

config RETRO_SCRIPTED_INPUT
	bool "Drive the core from the scripted synthetic input timeline"
	default n

config RETRO_SCRIPTED_CONTENT
	bool "Scripted timeline for the content-core gate (launch + pick WAD)"
	depends on RETRO_SCRIPTED_INPUT && RETRO_MENU
	default n
	help
	  M5 sim gate: instead of the two-core swap timeline, launch menu
	  entry 0 (the seeded content core), pick content entry 0 in the
	  browser, and hold while the core reads the file off the fs. Used
	  with overlays/qemu_content.conf.

module = RETRO
module-str = retro
source "subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
