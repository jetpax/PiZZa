/*
 * WO-BT-K1 M0/M1 — route PL011 uart0 to the on-module CYW43436 Bluetooth
 * controller and describe the Infineon AIROC HCI transport.
 *
 * Fixed facts (verified against RPi Linux bcm2708-rpi-bt.dtsi + the Zephyr
 * bcm2711 pinctrl on 2026-07-08):
 *   - BT UART: GPIO 32/33 TXD0/RXD0, GPIO 30/31 CTS0/RTS0, ALT3.
 *   - BT_REG_ON: GPIO 45 (Linux `shutdown-gpios = <&gpio 45>`), which in our
 *     split-bank scheme is bank1 pin 17 (45-28). &gpio1 is already enabled by
 *     the board DTS for WL_REG_ON.
 *   - Console stays on uart1 (mini-UART, GPIO 14/15), so uart0 is free.
 *
 * Baud: current-speed is left at 115200 and fw-download-speed /
 * hci-operation-speed are intentionally omitted, so the driver never re-rates
 * the UART — M0/M1 run entirely at 115200 (WO R1 mitigation). The generic
 * arm,pl011 driver does drive RTS/CTS, so flow control is real at this rate.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/bcm2711-pinctrl.h>

&pinctrl {
	uart0_bt_gpio32: uart0_bt_gpio32 {
		group1 {
			pinmux = <UART0_TX_GPIO32>, <UART0_RX_GPIO33>,
				 <UART0_CTS_GPIO30>, <UART0_RTS_GPIO31>;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	hw-flow-control;
	pinctrl-0 = <&uart0_bt_gpio32>;
	pinctrl-names = "default";

	bt_hci_uart: bt_hci_uart {
		compatible = "zephyr,bt-hci-uart";
		status = "okay";

		bt_hci: bt-hci {
			compatible = "infineon,bt-hci-uart";
			bt-reg-on-gpios = <&gpio1 17 GPIO_ACTIVE_HIGH>;
		};
	};
};

/ {
	chosen {
		/* Points at the OUTER zephyr,bt-hci-uart node (the H:4 driver),
		 * not the inner vendor node. */
		zephyr,bt-hci = &bt_hci_uart;
	};
};
