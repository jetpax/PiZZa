/*
 * PiZZa -- USB-CDC + HDMI overlay for rpi_zero_w.
 *
 * Enables the VC mailbox + firmware (needed to power-on the USB PHY
 * and to allocate the framebuffer), the DWC2 USB controller with a
 * CDC ACM child for the shell, and the VC framebuffer on HDMI.
 * Boot logs + LOG_* remain on the AUX mini-UART (uart1, set up by
 * the board DTS at 115200 on GPIO 14/15).
 */

&mbox0 {
	status = "okay";
};

&firmware {
	status = "okay";
};

&usb {
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "PiZZa shell (USB CDC ACM)";
	};
};

/ {
	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

/*
 * PWM channels 0 / 1 on header pins 32 / 33 (GPIO 12 / 13, ALT0).
 * Bring-up: `pwm cycles <dev> <chan> <period> <pulse>` from the shell
 * -- e.g. `pwm cycles pwm@X 0 24489 12245` is ~392 Hz at 50% duty on
 * GPIO 12 with the default 9.6 MHz reference clock.
 */
&pwm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_gpio12>;
	status = "okay";
};

/*
 * HDMI framebuffer. VC owns the HDMI block and scans this buffer out
 * continuously; the ARM side asks for it at runtime over the mailbox
 * property channel. &dma drives the backbuffer blit.
 */
&dma {
	status = "okay";
};

&vc_fb {
	/* No width / height: driver auto-detects from VC's EDID
	 * negotiation -- whatever the attached monitor's native mode is,
	 * matching the Zero 2 W overlay.
	 */
	status = "okay";
};

/ {
	chosen {
		zephyr,display = &vc_fb;
	};
};

/*
 * External microSD through the SDHost controller, GPIO 48..53 in ALT0
 * via the sdhost_gpio48 group. bcm2835.dtsi leaves the node disabled
 * and no board DTS turns it on, so the app has to; the pinctrl state
 * and the sdmmc child mirror the Arduino rpi_zero_w variant, which is
 * where this recipe was proven.
 *
 * Note this is the card the board boots from. The Zero W has a single
 * FAT partition, so what appears at /SD: is the live boot volume with
 * config.txt and the kernels on it, mounted read-write. `fs rm` from
 * the shell can make the card unbootable.
 */
&sdhost {
	pinctrl-names = "default";
	pinctrl-0 = <&sdhost_gpio48>;
	status = "okay";

	sdmmc {
		compatible = "zephyr,sdmmc-disk";
		disk-name = "SD";
	};
};

/*
 * Automount at /SD: so `fs ls /SD:` and the `pizza` storage line work
 * as soon as the shell is up. Format-on-mount-failure is off in the
 * board .conf, so a card that fails to mount is never erased.
 */
/ {
	fstab {
		compatible = "zephyr,fstab";

		sd_fs: sd {
			compatible = "zephyr,fstab,fatfs";
			automount;
			disk-access;
			mount-point = "/SD:";
		};
	};
};
