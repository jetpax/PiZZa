/*
 * PiZZa -- USB-CDC + HDMI overlay for rpi_zero_w.
 *
 * Enables the VC mailbox + firmware (needed to power-on the USB PHY
 * and to allocate the framebuffer), the DWC2 USB controller with a
 * CDC ACM child for the shell, and the VC framebuffer on HDMI.
 * Boot logs + LOG_* remain on the AUX mini-UART (uart1, set up by
 * the board DTS at 115200 on GPIO 14/15).
 */

&mbox0 {
	status = "okay";
};

&firmware {
	status = "okay";
};

&usb {
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		label = "PiZZa shell (USB CDC ACM)";
	};
};

/ {
	chosen {
		zephyr,console = &uart1;
		zephyr,shell-uart = &cdc_acm_uart0;
	};
};

/*
 * PWM channels 0 / 1 on header pins 32 / 33 (GPIO 12 / 13, ALT0).
 * Bring-up: `pwm cycles <dev> <chan> <period> <pulse>` from the shell
 * -- e.g. `pwm cycles pwm@X 0 24489 12245` is ~392 Hz at 50% duty on
 * GPIO 12 with the default 9.6 MHz reference clock.
 */
&pwm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_gpio12>;
	status = "okay";
};

/*
 * HDMI framebuffer. VC owns the HDMI block and scans this buffer out
 * continuously; the ARM side asks for it at runtime over the mailbox
 * property channel. &dma drives the backbuffer blit.
 */
&dma {
	status = "okay";
};

&vc_fb {
	/* No width / height: driver auto-detects from VC's EDID
	 * negotiation -- whatever the attached monitor's native mode is,
	 * matching the Zero 2 W overlay.
	 */
	status = "okay";
};

/ {
	chosen {
		zephyr,display = &vc_fb;
	};
};
